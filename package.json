{
  "name": "ghafra-backend",
  "version": "1.0.0",
  "description": "GHAFRA backend — Supabase, FCM, Resend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "npx tsx watch src/app.ts",
    "build": "tsc && cp -r src/modules/french-ai/data dist/modules/french-ai/",
    "start": "node dist/app.js",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:seed": "npx supabase db reset --with-seed"
  },
  "keywords": [],
  "author": "GHAFRA",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@types/multer": "^2.1.0",
    "@types/node-fetch": "^2.6.13",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "form-data": "^4.0.5",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "readline": "^1.3.0",
    "resend": "^6.10.0",
    "stripe": "^22.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
