PORT=5000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-server-only-service-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
RESEND_API_KEY=re_replace-me
RESEND_FROM_EMAIL=noreply@example.com
GROQ_API_KEY=gsk_replace-me
GROQ_API_KEY_1=gsk_replace-me
GROQ_API_KEY_2=gsk_replace-me
GROQ_API_KEY_3=gsk_replace-me
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GROQ_MODEL_LARGE=openai/gpt-oss-120b
HF_API_TOKEN=hf_replace-me
CARD_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ── Optional: push + jobs ────────────────────────────────────
# Expo access token (expo.dev → Account → Access tokens). Optional but recommended.
EXPO_ACCESS_TOKEN=
APP_TIMEZONE=Europe/Paris
# Secret for POST /jobs/tick — call it every 5 min from cron-job.org (free) so
# reminders run even when the free Render instance sleeps. 16+ random chars.
JOBS_SECRET=
# Only ONE running instance should have RUN_JOBS=true
RUN_JOBS=true
